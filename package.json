{
  "name": "currency_converter",
  "version": "0.1.2",
  "keywords": [
    "converter",
    "currency"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && bun run sentry:sourcemaps",
    "watch": "ng build --watch --configuration development",
    "tests": "ng test",
    "tests_ci": "ng test --watch=false",
    "lint": "ng lint",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org chicki-bricki --project javascript-angular ./dist && sentry-cli sourcemaps upload --org chicki-bricki --project javascript-angular ./dist"
  },
  "private": true,
  "author": "dimidroll450",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dimidroll450/currency_converter/issues"
  },
  "homepage": "https://github.com/dimidroll450/currency_converter#readme",
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@sentry/angular": "^10.68.0",
    "@sentry/cli": "^2.39.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "angular-eslint": "22.1.0",
    "eslint": "^9.28.0",
    "happy-dom": "^20.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.0.8"
  }
}
